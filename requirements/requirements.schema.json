{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edu-circuit/requirements.schema.json",
  "title": "Edu Circuit Requirements",
  "type": "object",
  "required": ["spec_version","project","requirements"],
  "properties": {
    "spec_version":{"type":"string"},
    "project":{"const":"edu-circuit"},
    "states":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "priorities":{"type":"array","items":{"enum":["MUST","SHOULD","LATER"]},"uniqueItems":true},
    "requirements":{"type":"array","items":{"type":"object","required":["id","title","state","priority","phase","statement","acceptance","modules","physics_rules","fixtures","docs"],"properties":{"id":{"type":"string","pattern":"^(EDT|SIM|VIS|MEA|TCH|DAT|QLT)-[0-9]{3}$"},"title":{"type":"string","minLength":1},"state":{"enum":["accepted","proposed","deferred","superseded"]},"priority":{"enum":["MUST","SHOULD","LATER"]},"phase":{"oneOf":[{"type":"integer","minimum":0,"maximum":7},{"enum":["all","later"]}]},"statement":{"type":"string","minLength":1},"acceptance":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"modules":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"physics_rules":{"type":"array","items":{"type":"string","pattern":"^PV-[0-9]{2}$"},"uniqueItems":true},"fixtures":{"type":"array","items":{"type":"string","pattern":"^FIX-[0-9]{2}$"},"uniqueItems":true},"docs":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
