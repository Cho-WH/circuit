{
  "name": "circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run",
    "test:firestore": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-circuit-feedback \"node tools/test-feedback-firestore.mjs\"",
    "check:boundaries": "node tools/check-boundaries.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^20.14.5",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
